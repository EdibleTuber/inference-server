# config/manager.env
# Configuration for the model manager proxy service.

# Address to bind to. Set to your server's LAN IP, or 0.0.0.0 for all interfaces.
HOST=0.0.0.0
PORT=11434

# Where llama-server is running (always localhost since it's on the same machine).
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8081

# Path to the directory containing GGUF model files.
MODELS_DIR=/opt/llama/models

# Path to the llama-server environment file (manager updates MODEL_PATH here during swaps).
LLAMA_SERVER_ENV=/etc/llama/llama-server.env

# Systemd unit name for the main llama-server (manager calls systemctl restart on this).
LLAMA_SERVER_UNIT=llama-server.service

# Maximum number of requests to hold in the FIFO queue.
# Requests beyond this limit get a 503 response.
QUEUE_LIMIT=50

# How long to wait (seconds) for llama-server to become healthy after a model swap.
# If this timeout is exceeded, the manager enters error state.
#
# An upper bound, not a delay: wait_for_health() polls every 2 s and returns as
# soon as the slot answers, so a generous value costs nothing on a good load and
# only postpones the error on a broken one. 120 was too tight -- a cold
# load-to-ready of Qwen3.5-35B-A3B (20.5 GiB, read from disk) measured 128 s on
# 2026-10-03 -- so this matches the 600 already deployed in /etc/llama.
SWAP_TIMEOUT=600

# Log file path for the model manager.
LOG_FILE=/var/log/llama/manager.log

# ---------------------------------------------------------------------------
# Embedding instance (CPU-only, nomic-embed-text)
# ---------------------------------------------------------------------------
EMBEDDINGS_HOST=127.0.0.1
EMBEDDINGS_PORT=8082

# ---------------------------------------------------------------------------
# Collection-based document retrieval
# ---------------------------------------------------------------------------
COLLECTIONS_CONFIG=/etc/llama/collections.json
SKILLS_DB_PATH=/opt/llama/data/skills.db

# ---------------------------------------------------------------------------
# Slot membership and order (manager/slot_config.py)
# ---------------------------------------------------------------------------
# Which slots the manager fronts, and the priority order request routing
# walks (main first). Written out explicitly rather than left to the
# main-only default. Every name here needs a running backend: a slot name
# with nothing behind it makes the manager report that slot as permanently
# unhealthy rather than simply absent.
SLOTS=main,egpu

# Home slot per model (manager/slot_config.py, routing.home_slot). An untargeted
# POST /swap -- which agent_core >= v1.11 clients send after a model_not_loaded
# 409 -- loads the model onto its home slot. A model listed nowhere is refused
# with 400 rather than loaded onto main. A model may have only one home; listing
# it on two slots stops the manager at startup. A swap that names a 'target' is
# unaffected. Keep main's list short: anything listed there can evict main.
SLOT_MAIN_MODELS=Qwen3.8-27B-UD-Q6_K
SLOT_EGPU_MODELS=Qwen3.6-35B-A3B-UD-IQ4_NL_XL

# ---------------------------------------------------------------------------
# EGPU inference slot (P40 eGPU)
# ---------------------------------------------------------------------------
# Backed by systemd/llama-server-egpu.service with config/llama-server-egpu.env
# (deployed to /etc/llama/ with the P40's real UUID -- see that file's
# comment). SLOT_EGPU_DEVICE mirrors that CUDA_VISIBLE_DEVICES UUID; it is not
# yet read by any code -- see manager/slot_config.py's `device` field,
# plumbed for a later consumer. Like that file, never commit the real UUID.
SLOT_EGPU_HOST=127.0.0.1
SLOT_EGPU_PORT=8084
SLOT_EGPU_ENV=/etc/llama/llama-server-egpu.env
SLOT_EGPU_UNIT=llama-server-egpu.service
SLOT_EGPU_QUEUE_LIMIT=20
SLOT_EGPU_DEVICE=GPU-<uuid-of-the-p40-see-config/llama-server-egpu.env>
