# systemd/llama-server-egpu.service
#
# Systemd unit for the llama.cpp inference backend -- egpu slot (P40 eGPU).
#
# Runs llama-server as the _llama user, bound to localhost only. Mirrors
# systemd/llama-server.service (the main slot) in structure; see that file
# for the rationale behind flags not re-explained here.
#
# Configuration is in /etc/llama/llama-server-egpu.env, plus one generated
# file per model: /var/lib/llama-manager/egpu.env. The model manager
# rewrites the generated file from the model's profile when swapping models
# on this slot, then restarts this service via sudo systemctl restart.
#
# Only install this unit on a host with the P40 attached. The template
# config/manager.env lists `egpu` in SLOTS; drop it on a host without this
# backend, or the manager reports the slot as permanently unhealthy.
#
# Install:
#   1. Get its UUID: nvidia-smi --query-gpu=uuid,pci.bus_id,name --format=csv
#   2. sudo cp systemd/llama-server-egpu.service /etc/systemd/system/
#   3. sudo cp config/llama-server-egpu.env /etc/llama/llama-server-egpu.env
#      then edit the deployed copy: set CUDA_VISIBLE_DEVICES to the P40's
#      real UUID from step 1 (see that file's comment).
#   4. sudo systemctl daemon-reload && sudo systemctl enable llama-server-egpu
#   5. Add ",egpu" to SLOTS in /etc/llama/manager.env, then restart the manager.

[Unit]
Description=llama.cpp Inference Server (egpu slot, P40 eGPU)
Documentation=https://github.com/ggerganov/llama.cpp

# Wait for NVIDIA drivers before starting.
After=network-online.target nvidia-persistenced.service
Wants=network-online.target

[Service]
Type=simple

# Dedicated unprivileged user — no shell, no home directory.
User=_llama
Group=_llama

# Unit-level default for DEVICE — overridden by any DEVICE= in the env file.
# MUST come before EnvironmentFile= below: systemd applies
# Environment=/EnvironmentFile= in file order and later assignments win, so
# if this line came after EnvironmentFile= it would always override the env
# file's DEVICE= instead of being overridden by it. Mirrors
# systemd/llama-server.service's DEVICE ordering exactly.
#
# CUDA_VISIBLE_DEVICES has no unit-level default here, deliberately: unlike
# DEVICE=CUDA0 (a stable convention any CUDA slot can share), the UUID it
# must hold is specific to one physical card in one machine, so it belongs
# only in the host-local env file below — never in this repo-committed
# unit. See config/llama-server-egpu.env's CUDA_VISIBLE_DEVICES comment.
Environment=DEVICE=CUDA0

# The generated model env file: rewritten whole by the manager on every
# swap from this slot's section of the model's profile. Loaded BEFORE the
# static env file below, so a stray HOST/PORT/DEVICE in it can never move
# the server. See systemd/llama-server.service for the full rationale.
EnvironmentFile=/var/lib/llama-manager/egpu.env

# Load runtime configuration.
EnvironmentFile=/etc/llama/llama-server-egpu.env

# Start llama-server with config from the env files. Same flag set as
# systemd/llama-server.service (see that file for per-flag rationale) so
# the two CUDA slots behave identically.
# --parallel: 1, not 2. It DIVIDES --ctx-size across slots -- verified on
#   b11136 that --ctx-size 8192 --parallel 2 yields "n_slots = 2,
#   n_ctx_slot = 4096". This slot serves PARE, one conversation at a time,
#   and wants the whole window.
# $MODEL_ARGS: the whole per-model argument list, rendered by the manager
#   from the model's profile on every swap. Deliberately NOT hardcoded here:
#   this slot is swappable too, and settings tuned for one model are wrong
#   for the next. MUST stay unbraced: systemd word-splits $VAR but passes
#   ${VAR} as a single argument, which llama-server rejects.
ExecStart=/opt/llama/bin/llama-server \
    --host ${HOST} \
    --port ${PORT} \
    --device ${DEVICE} \
    --parallel 1 \
    --cache-ram 0 \
    $MODEL_ARGS

# Auto-restart on crash with delay to prevent loops.
Restart=on-failure
RestartSec=5

# Persistent file logs (also in journal via journalctl -u llama-server-egpu)
StandardOutput=append:/var/log/llama/llama-server-egpu.log
StandardError=append:/var/log/llama/llama-server-egpu.err

[Install]
WantedBy=multi-user.target
