# systemd/llama-server.service
#
# Systemd unit for the llama.cpp inference backend.
#
# Runs llama-server as the _llama user, bound to localhost only.
# The model manager proxy is the only thing that talks to this service.
#
# Configuration is in /etc/llama/llama-server.env, plus one generated file
# per model: /var/lib/llama-manager/main.env. The model manager rewrites
# the generated file from the model's profile on every swap (the whole
# MODEL_ARGS line: model path, context, GPU layers, sampling, flags), then
# restarts this service via sudo systemctl restart.
#
# Install: sudo cp systemd/llama-server.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable llama-server

[Unit]
Description=llama.cpp Inference Server
Documentation=https://github.com/ggerganov/llama.cpp

# Wait for NVIDIA drivers before starting.
After=network-online.target nvidia-persistenced.service
Wants=network-online.target

[Service]
Type=simple

# Dedicated unprivileged user — no shell, no home directory.
User=_llama
Group=_llama

# Unit-level default for DEVICE — overridden by any DEVICE= in the env file.
# Keeps the Tesla P40 pinned even on a redeploy that skips the live env file
# (setup.sh does not overwrite an existing env). MUST come before
# EnvironmentFile= below: systemd applies Environment=/EnvironmentFile= in
# file order and later assignments win, so if this line comes after
# EnvironmentFile= it always overrides the env file's DEVICE= instead of
# being overridden by it.
#
# CUDA_VISIBLE_DEVICES has no unit-level default here, deliberately: unlike
# DEVICE=CUDA0 (a stable convention any CUDA slot can share), the UUID it
# must hold is specific to one physical card in one machine, so it belongs
# only in the host-local env file below -- never in this repo-committed
# unit. See config/llama-server.env's CUDA_VISIBLE_DEVICES comment for how
# that value is obtained and why an ordinal is not sufficient.
Environment=DEVICE=CUDA0

# The generated model env file: the manager renders this slot's section of
# the current model's profile into it on every swap, so every model-specific
# setting lives in one place and is rewritten whole -- nothing can carry over
# from the previous model. Loaded BEFORE the static env file below, so a
# stray HOST/PORT/DEVICE in it can never move the server: the static file's
# values win.
EnvironmentFile=/var/lib/llama-manager/main.env

# Load runtime configuration. GGML_CUDA_DISABLE_GRAPHS=1 (workaround for a
# CUDA-graph-cache host-RAM leak, llama.cpp issue #20315) lives in that env
# file rather than here, so it's visible alongside the other tuning knobs.
EnvironmentFile=/etc/llama/llama-server.env

# Start llama-server with config from the env files.
# --host/--port: localhost only (manager handles external access)
# --device: explicit CUDA device selector (fail-loud; no silent iGPU fallback)
# --parallel: explicit slot count. NOTE it DIVIDES the context: --ctx-size is
#   the total, split evenly across slots, so --parallel 2 halves what any single
#   conversation can use. Verified on b11136: --ctx-size 8192 --parallel 2 gives
#   "n_slots = 2, n_ctx_slot = 4096". This slot serves one agent at a time and
#   wants the whole window, so it is 1. Raising it silently shrinks the usable
#   context unless --ctx-size is raised to match. It also bounds how many
#   concurrent conversations can each grow their own checkpoint stack at once.
# --cache-ram 0: DISABLE llama-server's default host-memory KV/prompt cache.
#   That cache (default ~8GB, llama.cpp PR #16391) accumulates KV across
#   conversations and never releases, and its size cap is ineffective on Linux
#   due to overcommit (issue #22629) — it grew unbounded to 23.6GB and OOM-killed
#   this service (2026-07-04). Disabling it drops idle host RAM ~9.7GB -> ~250MB
#   and makes memory grow-under-load / release-on-idle instead of leaking.
#   Trade-off: no cross-conversation prompt reuse (minor prefill cost).
# $MODEL_ARGS: the whole per-model argument list, rendered by the manager from
#   the model's profile on every swap. Deliberately NOT hardcoded here: the
#   model-specific settings must travel with the model, not with the service
#   definition. A hardcoded "--temp 0.2" set for gemma-4-26b outlived it and
#   was silently applied to Qwen3.8-27B, which asks for 1.0.
#
#   IT MUST STAY UNBRACED. systemd word-splits $VAR but NOT ${VAR}: the braced
#   form passes the whole string as ONE argument and llama-server rejects it.
#   Verified on this host:
#     $SA   -> [--temp] [1.0] [--top-k] [20]
#     ${SA} -> [--temp 1.0 --top-k 20]        (single arg, wrong)
ExecStart=/opt/llama/bin/llama-server \
    --host ${HOST} \
    --port ${PORT} \
    --device ${DEVICE} \
    --parallel 1 \
    --cache-ram 0 \
    $MODEL_ARGS

# Auto-restart on crash with delay to prevent loops.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
